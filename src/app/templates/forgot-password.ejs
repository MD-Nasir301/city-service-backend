<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OTP Verification</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f7f6;
      margin: 0;
      padding: 0;
      color: #333333;
    }
    .email-container {
      max-width: 500px;
      margin: 40px auto;
      background-color: #ffffff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      border: 1px solid #e0e0e0;
    }
    .header {
      background-color: #4F46E5;
      color: #ffffff;
      text-align: center;
      padding: 25px 20px;
    }
    .header h1 {
      margin: 0;
      font-size: 22px;
      font-weight: 600;
      letter-spacing: 0.5px;
    }
    .content {
      padding: 30px 25px;
      line-height: 1.6;
    }
    .greeting {
      font-size: 18px;
      font-weight: 600;
      color: #1F2937;
      margin-bottom: 12px;
    }
    .text {
      font-size: 14px;
      color: #4B5563;
      margin-bottom: 25px;
    }
    .otp-box {
      background-color: #F3F4F6;
      border: 2px dashed #4F46E5;
      border-radius: 8px;
      text-align: center;
      padding: 15px;
      margin: 20px 0;
    }
    .otp-code {
      font-size: 32px;
      font-weight: 700;
      color: #4F46E5;
      letter-spacing: 6px;
      margin: 0;
    }
    .expiry-text {
      font-size: 12px;
      color: #EF4444;
      text-align: center;
      margin-top: 8px;
      font-weight: 500;
    }
    .footer {
      background-color: #F9FAFB;
      text-align: center;
      padding: 15px 20px;
      font-size: 12px;
      color: #9CA3AF;
      border-top: 1px solid #E5E7EB;
    }
  </style>
</head>
<body>

  <div class="email-container">
    <!-- Header -->
    <div class="header">
      <h1>Account Verification</h1>
    </div>

    <!-- Content -->
    <div class="content">
      <div class="greeting">Hello, <%= name %>!</div>
      
      <p class="text">
        Thank you for joining us. Please use the One-Time Password (OTP) below to complete your verification process.
      </p>

      <!-- OTP Box -->
      <div class="otp-box">
        <div class="otp-code"><%= otp %></div>
      </div>

      <p class="expiry-text">⚠️ This code will expire in <%= expiryMinutes %> minutes.</p>

      <p class="text" style="margin-top: 25px; font-size: 13px; color: #6B7280;">
        If you didn't request this code, please ignore this email or contact support if you have concerns.
      </p>
    </div>

    <!-- Footer -->
    <div class="footer">
      &copy; <%= new Date().getFullYear() %> Your Company Name. All rights reserved.
    </div>
  </div>

</body>
</html>
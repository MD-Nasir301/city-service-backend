<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Changed Successfully</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f4f7f6; padding: 40px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" style="max-width: 500px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05); padding: 40px; border: 1px solid #e2e8f0;">
          
          <!-- Header / Brand -->
          <tr>
            <td align="center" style="padding-bottom: 24px; border-bottom: 1px solid #edf2f7;">
              <h1 style="color: #2b6cb0; font-size: 24px; margin: 0; font-weight: 700;">PH HealthCare</h1>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding-top: 30px; color: #2d3748;">
              <h2 style="font-size: 18px; color: #2f855a; margin-top: 0; margin-bottom: 12px;">✅ Password Changed Successfully</h2>
              <p style="font-size: 14px; line-height: 1.6; color: #4a5568; margin-bottom: 16px;">
                Hello <strong><%= name %></strong>,
              </p>
              <p style="font-size: 14px; line-height: 1.6; color: #4a5568; margin-bottom: 24px;">
                Your password for PH HealthCare has been updated successfully.
              </p>
            </td>
          </tr>

          <!-- Security Alert Box -->
          <tr>
            <td style="padding: 16px; background-color: #fffaf0; border-left: 4px solid #dd6b20; border-radius: 4px; margin-bottom: 24px;">
              <p style="margin: 0; font-size: 13px; color: #9c4221; line-height: 1.5;">
                <strong>Didn't request this change?</strong> If you did not perform this action, please contact our support team immediately to secure your account.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding-top: 30px; margin-top: 30px; border-top: 1px solid #edf2f7; color: #a0aec0; font-size: 12px;">
              <p style="margin: 0;">&copy; PH HealthCare. All rights reserved.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
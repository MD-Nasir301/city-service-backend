<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Your Email</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f4f7f6; padding: 40px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" style="max-width: 500px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05); padding: 40px; border: 1px solid #e2e8f0;">
          
          <!-- Header / Brand -->
          <tr>
            <td align="center" style="padding-bottom: 24px; border-bottom: 1px solid #edf2f7;">
              <h1 style="color: #2b6cb0; font-size: 24px; margin: 0; font-weight: 700;">City Services Platform</h1>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding-top: 30px; color: #2d3748;">
              <h2 style="font-size: 18px; color: #1a202c; margin-top: 0; margin-bottom: 12px;">Hello <%= name %>,</h2>
              <p style="font-size: 14px; line-height: 1.6; color: #4a5568; margin-bottom: 24px;">
                Thank you for registering with City Services Platform! To complete your registration and verify your email address, please use the One-Time Password (OTP) code below:
              </p>
            </td>
          </tr>

          <!-- OTP Box -->
          <tr>
            <td align="center" style="padding: 10px 0 25px 0;">
              <div style="display: inline-block; background-color: #e6fffa; border: 1px dashed #319795; border-radius: 6px; padding: 14px 28px;">
                <span style="font-size: 28px; font-weight: bold; color: #2c7a7b; letter-spacing: 6px;"><%= otpValue %></span>
              </div>
            </td>
          </tr>

          <!-- Expiration Warning -->
          <tr>
            <td style="color: #718096; font-size: 13px; line-height: 1.5;">
              <p style="margin: 0 0 10px 0;">⏱️ This verification code is valid for <strong>5 minutes</strong>. Do not share this code with anyone.</p>
              <p style="margin: 0;">If you didn't create an account with City Services Platform, you can safely ignore this email.</p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding-top: 30px; margin-top: 30px; border-top: 1px solid #edf2f7; color: #a0aec0; font-size: 12px;">
              <p style="margin: 0;">&copy; City Services Platform. All rights reserved.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
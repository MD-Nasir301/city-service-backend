model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  entityName String
  entityId   String
  details    Json?
  createdAt DateTime @default(now())

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id], onDelete: Cascade)
 
  @@map("audit_logs")
}
